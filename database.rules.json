{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.token.email_verified === true && auth.token.email === 'admin@myparentcare.com'",
        ".validate": "newData.isBoolean() && newData.val() === true"
      }
    },
    "admin_workspace": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "audit_logs": {
        ".indexOn": [
          "at"
        ],
        "$logId": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && !data.exists()",
          ".validate": "newData.hasChildren(['action', 'actorUid', 'actorEmail', 'summary', 'at']) && newData.child('actorUid').val() === auth.uid && newData.child('at').isNumber() && newData.child('at').val() <= now",
          "action": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "actorUid": {
            ".validate": "newData.isString()"
          },
          "actorEmail": {
            ".validate": "newData.isString() && newData.val().length <= 254"
          },
          "summary": {
            ".validate": "newData.isString() && newData.val().length <= 500"
          },
          "targetType": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "targetId": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "presence": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && root.child('admins').child(auth.uid).val() === true",
          ".validate": "newData.hasChildren(['online', 'lastSeen'])",
          "online": {
            ".validate": "newData.isBoolean()"
          },
          "lastSeen": {
            ".validate": "newData.isNumber()"
          },
          "email": {
            ".validate": "newData.isString() && newData.val().length <= 254"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "backups": {
        ".indexOn": [
          "at"
        ],
        "$backupId": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true && !data.exists()",
          ".validate": "newData.hasChildren(['at', 'by', 'byEmail', 'documents', 'bytes', 'kind']) && newData.child('by').val() === auth.uid",
          "at": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "by": {
            ".validate": "newData.isString()"
          },
          "byEmail": {
            ".validate": "newData.isString() && newData.val().length <= 254"
          },
          "documents": {
            ".validate": "newData.isNumber()"
          },
          "bytes": {
            ".validate": "newData.isNumber()"
          },
          "kind": {
            ".validate": "newData.val() === 'backup' || newData.val() === 'restore'"
          },
          "note": {
            ".validate": "newData.isString() && newData.val().length <= 300"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "notes": {
        "$noteId": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
          ".validate": "!newData.exists() || (newData.hasChildren(['text', 'by', 'at']) && newData.child('text').isString() && newData.child('text').val().length <= 1000)"
        }
      },
      "settings": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        "emailjs": {
          ".validate": "newData.hasChildren(['privateKey', 'updatedBy', 'updatedAt'])",
          "privateKey": {
            ".validate": "newData.isString() && newData.val().length >= 10 && newData.val().length <= 100"
          },
          "updatedBy": {
            ".validate": "newData.val() === auth.uid"
          },
          "updatedAt": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "programs": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "participants": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "student_history": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "student_notifications": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "announcements": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "email_logs": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "system_errors": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    }
  }
}
